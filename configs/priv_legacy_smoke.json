{
 "_comment": [
  "Smoke test of configs/priv_legacy_<env>.json: every condition once on Hopper gear2x, 3000 steps, switch at 1500.",
  "Login node, ~2 min: CONFIG=configs/priv_legacy_smoke.json bash scripts/trillium/smoke_levers.sh"
 ],
 "defaults": {
  "N": 3000,
  "seeds": [
   18606
  ],
  "gamma": 0.99,
  "beta1": 0.0,
  "normalize_obs": true,
  "pnorm": true,
  "scaled_td": true,
  "n_eval": 1,
  "video_every": 1500,
  "save_model": true,
  "save_model_every": 1000000,
  "dense_window": [
   500,
   1000
  ],
  "checkpoint": 1000
 },
 "envs": {
  "Hopper-v4": {
   "actor_lr": 1.1e-05,
   "critic_lr": 7.7e-05,
   "alpha_lr": 0.3
  }
 },
 "experiments": [
  {
   "name": "legacy-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "legacy_g_reset": true
  },
  {
   "name": "scratch-gear2x",
   "env_mods": {
    "gear_scale": 2.0
   },
   "legacy_g_reset": true
  },
  {
   "name": "L02_shrink_obs-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "on_shift": [
    {
     "action": "shrink_obs_norm",
     "count": 1000
    }
   ],
   "legacy_g_reset": true
  },
  {
   "name": "P1_alpha_x0.1-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "on_shift": [
    {
     "action": "set_alpha",
     "k": 0.1,
     "steps": 300000
    }
   ],
   "legacy_g_reset": true
  },
  {
   "name": "P1_alpha_x0.3-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "on_shift": [
    {
     "action": "set_alpha",
     "k": 0.3,
     "steps": 300000
    }
   ],
   "legacy_g_reset": true
  },
  {
   "name": "P2_alpha_track-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "on_shift": [
    {
     "action": "alpha_track",
     "target": 1.45,
     "steps": 500000,
     "eta": 0.0001,
     "window": 1000,
     "min": 0.02,
     "max": 2.0,
     "release": 100000
    }
   ],
   "legacy_g_reset": true
  },
  {
   "name": "P3_reward_offset-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "on_shift": [
    {
     "action": "reward_offset",
     "offset": 0.38,
     "steps": 300000
    }
   ],
   "legacy_g_reset": true
  },
  {
   "name": "P4_priv_obs-gear2x",
   "schedule": [
    {
     "step": 1500,
     "mods": {
      "gear_scale": 2.0
     }
    }
   ],
   "on_shift": [
    {
     "action": "load_stats",
     "path": "$SCRATCH/results/scratch-gear2x-Hopper-v4-18606-*/*_model_1M.pt",
