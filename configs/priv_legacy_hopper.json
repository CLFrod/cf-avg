{
 "_comment": [
  "Lever study batch 2 (privileged targets) with the legacy G reset in every run on Hopper-v4: 6M steps, physics switch at 3M.",
  "Per shift: legacy base, from-scratch, batch-1 obs-shrink reference, 4 privileged singles, 6 stacks = 13 conditions x 5 seeds (analyse with --base legacy).",
  "Generated by scripts/make_privileged_configs.py from configs/privileged_targets.json; regenerate rather than edit.",
  "P4 loads the observation statistics of the from-scratch run's 1M snapshot (batch-1 results under stats_root)."
 ],
 "defaults": {
  "N": 6000000,
  "seeds": [
   18606,
   16858,
   63790,
   15097,
   62693
  ],
  "gamma": 0.99,
  "beta1": 0.0,
  "normalize_obs": true,
  "pnorm": true,
  "scaled_td": true,
  "n_eval": 2,
  "video_every": 3000000,
  "save_model": true,
  "save_model_every": 1000000,
  "dense_window": [
   20000,
   200000
  ]
 },
 "envs": {
  "Hopper-v4": {
   "actor_lr": 1.1e-05,
   "critic_lr": 7.7e-05,
   "alpha_lr": 0.3
  }
 },
