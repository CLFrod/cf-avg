{
 "_comment": [
  "Greedy AC as a shift-recovery method on Hopper-v4 under the G-truncation fix: 6M steps, physics switch at 3M.",
  "Per shift: fix base, GAC at the shift (alone, + obs soft reset, 1M window, wide proposal, soft critic), best-of-30 control, GAC from step 0,",
  "entropy tracking with the corrected controller alone and in its three stacks (P2, P6, P9, P10) = 12 conditions x 10 seeds.",
  "Greedy AC: N=30 samples from the proposal, top 3 by Q, plain Sarsa critic unless soft_critic. 240 runs: submit with SHARD=1/2 and SHARD=2/2.",
  "Generated by scripts/make_greedy_configs.py; analyse with lever_recovery.py --base fix. P6/P9/P10 load obs stats from stats_root."
 ],
 "defaults": {
  "N": 6000000,
  "seeds": [
   18606,
   16858,
   63790,
   15097,
   62693,
   24601,
   7331,
   90210,
   41275,
   5812
  ],
  "gamma": 0.99,
  "beta1": 0.0,
  "normalize_obs": true,
  "pnorm": true,
  "scaled_td": true,
  "legacy_g_reset": false,
  "n_eval": 2,
  "video_every": 3000000,
  "save_model": true,
  "save_model_every": 1000000,
  "dense_window": [
   20000,
   200000
  ]
 },
 "envs": {
  "Hopper-v4": {
   "actor_lr": 1.1e-05,
   "critic_lr": 7.7e-05,
   "alpha_lr": 0.3
  }
 },
