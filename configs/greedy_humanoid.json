  "normalize_obs": true,
  "pnorm": true,
  "scaled_td": true,
  "legacy_g_reset": true,
  "n_eval": 2,
  "video_every": 6000000,
  "save_model": true,
  "save_model_every": 1000000,
  "dense_window": [
   20000,
   200000
  ]
 },
